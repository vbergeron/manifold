# WebSocket endpoint of the Manifold server (Bandit + WebSockAdapter).
# Only needed to override the default: same-origin in a production build (the app
# serves the page), ws://127.0.0.1:4000/socket in dev (Vite serves it on :5173).
VITE_WS_URL=ws://127.0.0.1:4000/socket

# Dev-only: drive the UI from a scripted fake event feed instead of the server.
# Also available per-load as ?mock=1. Ignored in production builds.
# VITE_MOCK=1
